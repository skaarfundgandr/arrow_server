meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: http://127.0.0.1:3000/api/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "newcustomer",
    "password": "newpassword"
  }
}

docs {
  The admin username is reserved (registration returns 409). Every registered
  user is auto-assigned the CUSTOMER role and receives a token on success.
}
