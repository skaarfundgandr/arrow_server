meta {
  name: Get Order By ID
  type: http
  seq: 2
}

get {
  url: http://127.0.0.1:3000/api/v1/orders/1
  body: none
  auth: inherit
}

docs {
  Access: ADMIN, the JWT owner of the order, or anyone with a valid signed
  order_url passed as query params (?exp=<unix>&sig=<signature>) - no JWT
  required for the order_url flow.
}
