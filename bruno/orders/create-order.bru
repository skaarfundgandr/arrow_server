meta {
  name: Create Order
  type: http
  seq: 4
}

post {
  url: http://127.0.0.1:3000/api/v1/orders
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "products": [
      {
        "product_id": 1,
        "quantity": 2
      },
      {
        "product_id": 2,
        "quantity": 1
      }
    ]
  }
}

docs {
  Public endpoint: an optional bearer token attributes the order to the user,
  otherwise it is a guest order (user_id null). Response is
  {order, order_url}: order contains per-item products with quantity,
  unit_price and line_total; order_url is a signed link (exp + sig query
  params) granting access/payment without a JWT.
}
