# ============================================================================
# Arrow Server - environment configuration
# Copy to .env and adjust. Values marked [REQUIRED] abort startup with a
# logged typed error and a non-zero exit code when missing; everything else
# falls back to the shown default.
# Read by: src/api/config.rs (all vars below) and src/data/database.rs
# (DATABASE_URL).
# ============================================================================

# --- Database ---------------------------------------------------------------
# [REQUIRED] MySQL connection string used by the diesel-async connection pool.
DATABASE_URL=mysql://test_user:test_password@127.0.0.1:3306/test_db

# --- Authentication (JWT) ---------------------------------------------------
# [REQUIRED] Secret used to sign and verify JWT access tokens.
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime in minutes. (default: 60)
JWT_EXPIRATION_MINUTES=60

# --- Admin bootstrap --------------------------------------------------------
# The server seeds the admin account from these variables on first start
# (idempotent; a user with the same username is never created twice).
# Admin username. (default: admin) - registration with this username returns 409.
ADMIN_USERNAME=admin
# [REQUIRED] Password for the seeded admin account.
ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# --- Signed order links (order_url) -----------------------------------------
# [REQUIRED] Secret used to sign order_url receipt links (HMAC-SHA256 over
# "order_id={id}&exp={exp}").
QR_SIGNING_SECRET=change-me-to-a-different-long-random-secret
# order_url lifetime in minutes. (default: 1440 = 24h)
ORDER_LINK_EXPIRATION_MINUTES=1440

# --- Public URLs ------------------------------------------------------------
# Base URL of the API, used when building order_url links and the QR target.
# (default: http://localhost:3000)
API_BASE_URL=http://localhost:3000
# Destination of the GET /api/v1/qr/visit redirect (the ordering frontend).
# (default: {API_BASE_URL}/api/v1/products)
ORDERING_BASE_URL=http://localhost:3000/api/v1/products

# --- Mock payment -----------------------------------------------------------
# Orders whose total_amount exceeds this value fail the mock payment.
# (default: 1000.00)
MAX_PAYMENT_AMOUNT=1000.00

# --- Azure Blob Storage (product images, optional) ---------------------------
# Optional: when unset, the product image upload/delete endpoints return 503
# and the server runs without object storage (external product_image_uri URLs
# still work unchanged).
# Storage account name. (default: unset)
AZURE_STORAGE_ACCOUNT=
# Private container that holds uploaded product images. (default: unset)
AZURE_STORAGE_CONTAINER=
# Dev-only account key: signs the short-lived SAS tokens used for upload,
# delete and read. When unset, uploads/deletes authenticate via managed
# identity but read SAS URLs cannot be minted. (default: unset)
AZURE_STORAGE_ACCOUNT_KEY=
# Lifetime of minted read SAS URLs in minutes. (default: 15)
IMAGE_SAS_TTL_MINUTES=15
# Maximum accepted product image size in bytes. (default: 2097152 = 2 MiB)
IMAGE_MAX_BYTES=2097152
