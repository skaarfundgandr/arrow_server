# Example Docker Compose setup for Arrow Server.
# Copy to compose.yml and adjust credentials before use.
services:
  db:
    image: mysql:8.4.10
    # Upgrading an existing 8.0 volume to 8.4 requires supported 8.0.x data
    # and the MySQL 8.0-to-8.4 upgrade prerequisites/checker (mysql_upgrade equivalent).
    # A fresh volume avoids this upgrade path.
    container_name: arrow_server_db
    restart: unless-stopped
    environment:
      - MYSQL_ROOT_PASSWORD=root_password
      - MYSQL_DATABASE=testdb
      - MYSQL_USER=user
      - MYSQL_PASSWORD=password
    ports:
      - "3306:3306"
    volumes:
      - arrow_server_db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uuser", "-ppassword"]
      interval: 5s
      timeout: 5s
      retries: 10

  # The container does not run migrations itself: apply them before first
  # start, e.g. `diesel migration run` against the db container (or apply
  # schema.sql) once the db is healthy.
  arrow_server:
    build: .
    container_name: arrow_server
    ports:
      - "3000:3000"
    environment:
      - DATABASE_URL=mysql://user:password@db:3306/testdb
      - JWT_SECRET=your_jwt_secret_key
      - JWT_EXPIRATION_MINUTES=60
      - ADMIN_USERNAME=admin
      - ADMIN_PASSWORD=your_admin_password
      - QR_SIGNING_SECRET=your_qr_signing_secret
      - ORDER_LINK_EXPIRATION_MINUTES=1440
      - API_BASE_URL=http://localhost:3000
      - ORDERING_BASE_URL=http://localhost:3000/api/v1/products
      - CORS_ALLOWED_ORIGINS=*
      - MAX_PAYMENT_AMOUNT=1000.00
      # Optional: Azure Blob Storage for product image uploads (see .env.example).
      # Uncomment and fill in to enable image upload; without it the image
      # endpoints return 503.
      # - AZURE_STORAGE_ACCOUNT=your_storage_account
      # - AZURE_STORAGE_CONTAINER=products
      # - AZURE_STORAGE_ACCOUNT_KEY=your_account_key
      # - IMAGE_SAS_TTL_MINUTES=15
      # - IMAGE_MAX_BYTES=2097152
    depends_on:
      db:
        condition: service_healthy

volumes:
  arrow_server_db_data:
